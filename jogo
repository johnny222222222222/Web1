<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LEVEL DEVIL - Clone</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');
  body{margin:0;background:#111;display:flex;justify-content:center;align-items:center;height:100vh;overflow:hidden;font-family:'Press Start 2P',monospace}
  #game{border:4px solid #fff;box-shadow:0 0 40px #ff0055}
  #ui{position:absolute;top:20px;left:50%;transform:translateX(-50%);color:#fff;text-align:center}
  #levelText{font-size:14px;margin-bottom:10px}
  #deaths{font-size:10px;color:#ff0055}
</style>
</head>
<body>
<div id="ui"><div id="levelText">LEVEL 1 / 8</div><div id="deaths">MORTES: 0</div></div>
<canvas id="game" width="1000" height="600"></canvas>
<script>
const canvas=document.getElementById('game'), ctx=canvas.getContext('2d');
const W=canvas.width, H=canvas.height;
let deaths=0, currentLevel=0;
const keys={};
const player={x:50,y:500,w:28,h:28,vx:0,vy:0,speed:5,jump:13,onGround:false,alive:true};

function getLevels(){
 return [
  // LEVEL 1 - Tutorial com troll
  { platforms:[{x:0,y:550,w:300,h:50},{x:400,y:550,w:600,h:50},{x:300,y:450,w:100,h:20}], spikes:[{x:300,y:530,w:100,h:20}], door:{x:900,y:450,w:50,h:100}, troll: ()=>{} },
  // LEVEL 2 - Buraco falso
  { platforms:[{x:0,y:550,w:450,h:50},{x:550,y:550,w:450,h:50},{x:200,y:400,w:120,h:20}], spikes:[{x:450,y:580,w:100,h:20,hidden:true}], door:{x:900,y:450,w:50,h:100}, troll: (ps)=>{ if(player.x>350) ps[1].x=300; } },
  // LEVEL 3 - Plataforma cai
  { platforms:[{x:0,y:550,w:200,h:50},{x:250,y:500,w:100,h:20,fall:true},{x:450,y:450,w:100,h:20},{x:650,y:550,w:350,h:50}], spikes:[{x:0,y:0,w:W,h:20},{x:200,y:580,w:50,h:20}], door:{x:900,y:450,w:50,h:100}, troll: ()=>{} },
  // LEVEL 4 - Espinhos sobem
  { platforms:[{x:0,y:550,w:1000,h:50},{x:100,y:400,w:150,h:20},{x:400,y:300,w:150,h:20},{x:700,y:200,w:150,h:20}], spikes:[{x:0,y:530,w:1000,h:20,rises:true}], door:{x:750,y:100,w:50,h:100}, troll: (ps,sp)=>{ if(player.y<350) sp[0].y=400; } },
  // LEVEL 5 - Porta foge
  { platforms:[{x:0,y:550,w:1000,h:50}], spikes:[{x:300,y:530,w:400,h:20}], door:{x:900,y:450,w:50,h:100,moves:true}, troll: (ps,sp,d)=>{ if(Math.abs(player.x-d.x)<150) d.x=100+Math.random()*700; } },
  // LEVEL 6 - Teto com espinhos
  { platforms:[{x:0,y:550,w:200,h:50},{x:300,y:550,w:200,h:50},{x:600,y:550,w:400,h:50},{x:100,y:350,w:800,h:20}], spikes:[{x:0,y:0,w:1000,h:30}], door:{x:900,y:450,w:50,h:100}, troll: ()=>{ if(player.y<400) player.vy+=0.8; } },
  // LEVEL 7 - Plataformas invisíveis
  { platforms:[{x:0,y:550,w:150,h:50},{x:900,y:550,w:100,h:50},{x:250,y:450,w:80,h:20,invis:true},{x:450,y:350,w:80,h:20,invis:true},{x:650,y:250,w:80,h:20,invis:true}], spikes:[{x:150,y:580,w:750,h:20}], door:{x:900,y:450,w:50,h:100}, troll: ()=>{} },
  // LEVEL 8 - FINAL BOSS TROLL
  { platforms:[{x:0,y:550,w:1000,h:50},{x:200,y:400,w:100,h:20},{x:500,y:300,w:100,h:20},{x:800,y:200,w:100,h:20}], spikes:[], door:{x:820,y:10０,w:5０,h:1００}, troll: (ps,sp,d)=>{ d.y=1００+Math.sin(Date.now()/2００)*8０; ps.forEach(p=>{ if(!p.fall) p.x+=Math.sin(Date.now()/5００+p.y)*０.５ }); } },
 ]
}

let levelData=null;
function loadLevel(n){
  const lvls=getLevels(); levelData=JSON.parse(JSON.stringify(lvls[n]));
  levelData.platforms.forEach(p=>{p.ox=p.x;p.oy=p.y;p.vy=0;p.visible=p.invis?false:true});
  levelData.spikes.forEach(s=>{s.oy=s.y});
  player.x=50;player.y=400;player.vx=0;player.vy=0;
  document.getElementById('levelText').innerText=`LEVEL ${n+1} / ${lvls.length}`;
}

function reset(){ deaths++; document.getElementById('deaths').innerText=`MORTES: ${deaths}`; loadLevel(currentLevel); }

window.addEventListener('keydown',e=>keys[e.code]=true);
window.addEventListener('keyup',e=>keys[e.code]=false);

function update(){
 if(!player.alive) return;
 if(keys['KeyA']||keys['ArrowLeft']) player.vx=-player.speed;
 else if(keys['KeyD']||keys['ArrowRight']) player.vx=player.speed;
 else player.vx*=0.8;
 if((keys['KeyW']||keys['Space']||keys['ArrowUp'])&&player.onGround){ player.vy=-player.jump; player.onGround=false; }
 player.vy+=0.7; player.x+=player.vx; player.y+=player.vy;

 // troll logic
 if(levelData.troll) levelData.troll(levelData.platforms, levelData.spikes, levelData.door);

 // platforms
 player.onGround=false;
 levelData.platforms.forEach(p=>{
   if(p.fall && player.onGround && player.x+player.w>p.x && player.x<p.x+p.w && Math.abs((player.y+player.h)-p.y)<10){ p.vy+=0.5; p.y+=p.vy; }
   if(p.invis){ if(Math.abs(player.x-p.x)<200) p.visible=true; }
   if(!p.visible) return;
   if(player.x+player.w>p.x && player.x<p.x+p.w && player.y+player.h>p.y && player.y+player.h<p.y+20 && player.vy>=0){ player.y=p.y-player.h; player.vy=0; player.onGround=true; }
 });

 // spikes
 for(let s of levelData.spikes){
   if(s.rises && player.onGround) s.y-=0.3;
   if(player.x+player.w>s.x && player.x<s.x+s.w && player.y+player.h>s.y && player.y<s.y+s.h){ reset(); return; }
 }
 if(player.y>H || player.y< -100) { reset(); return; }

 // porta
 let d=levelData.door;
 if(player.x+player.w>d.x && player.x<d.x+d.w && player.y+player.h>d.y && player.y<d.y+d.h){
   currentLevel++; if(currentLevel>=getLevels().length){ alert(`Zerou! Mortes: ${deaths} - Você é o DEVIL!`); currentLevel=0; deaths=0; }
   loadLevel(currentLevel);
 }
}

function draw(){
 ctx.fillStyle='#1a1a2e'; ctx.fillRect(0,0,W,H);
 // spikes
 ctx.fillStyle='#ff0055';
 levelData.spikes.forEach(s=>{ ctx.fillRect(s.x,s.y,s.w,s.h); for(let i=0;i<s.w;i+=15){ ctx.beginPath(); ctx.moveTo(s.x+i,s.y); ctx.lineTo(s.x+i+7,s.y-15); ctx.lineTo(s.x+i+15,s.y); ctx.fill(); } });
 // platforms
 levelData.platforms.forEach(p=>{
   if(p.invis &&!p.visible){ ctx.strokeStyle='#333'; ctx.strokeRect(p.ox,p.oy,p.w,p.h); return; }
   if(!p.visible) return;
   ctx.fillStyle=p.fall?'#ffaa00':'#fff'; ctx.fillRect(p.x,p.y,p.w,p.h);
 });
 // door
 let d=levelData.door; ctx.fillStyle='#00ff88'; ctx.fillRect(d.x,d.y,d.w,d.h); ctx.fillStyle='#000'; ctx.fillRect(d.x+15,d.y+40,10,10);
 // player
 ctx.fillStyle='#00d4ff'; ctx.fillRect(player.x,player.y,player.w,player.h); ctx.fillStyle='#fff'; ctx.fillRect(player.x+6,player.y+5,6,6); ctx.fillRect(player.x+16,player.y+5,6,6);
}

function loop(){ update(); draw(); requestAnimationFrame(loop); }
loadLevel(0); loop();
</script>
</body>
</html>